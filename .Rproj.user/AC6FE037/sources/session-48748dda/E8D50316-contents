moda <- function(x) {
  x <- na.omit(x)
  ux <- unique(x)
  ux[which.max(tabulate(match(x, ux)))]
}

tabla_descriptivos <- function(datos, variables, titulo = "Tabla", decimales = 2) {
  
  datos %>%
    select(all_of(variables)) %>%
    summarise(across(
      everything(),
      list(
        Mín    = ~min(.x, na.rm = TRUE),
        Q1     = ~quantile(.x, 0.25, na.rm = TRUE),
        Mdn    = ~median(.x, na.rm = TRUE),
        M      = ~mean(.x, na.rm = TRUE),
        Moda   = ~moda(.x),
        Q3     = ~quantile(.x, 0.75, na.rm = TRUE),
        Máx    = ~max(.x, na.rm = TRUE),
        DE     = ~sd(.x, na.rm = TRUE)
      ),
      .names = "{.col}__{.fn}"
    )) %>%
    tidyr::pivot_longer(everything(),
                         names_to = c("Variable", "Estadístico"),
                         names_sep = "__") %>%
    tidyr::pivot_wider(names_from = Estadístico, values_from = value) %>%
    select(Variable, Mín, Q1, Mdn, M, Moda, Q3, Máx, DE) %>%
    kbl(
      caption = titulo,
      booktabs = TRUE,
      digits = decimales,
      align = c("l", rep("c", 8)),
      linesep = ""
    ) %>%
    kable_styling(
      latex_options = c("hold_position", "scale_down"),
      full_width = FALSE,
      position = "center"
    ) %>%
    row_spec(0, bold = TRUE) %>%
footnote(
      general = "Elaboración propia.",
      general_title = "Nota.",
      footnote_as_chunk = TRUE,
      title_format = "italic"
    )
}

tabla_univariada <- function(datos, variable, titulo = "Tabla", 
                              nombre_var = "Categoría") {
  
  tabla <- datos %>%
    count({{ variable }}, name = "f") %>%
    mutate(
      `%` = round(100 * f / sum(f), 1),
      f_acum = cumsum(f),
      `% acum` = round(100 * f_acum / sum(f), 1)
    ) %>%
    rename(!!nombre_var := 1)
  
  # Fila de totales
  total <- tibble(
    !!nombre_var := "Total",
    f = sum(tabla$f),
    `%` = 100,
    f_acum = NA,
    `% acum` = NA
  )
  
  tabla_final <- bind_rows(tabla, total)
  
  tabla_final %>%
    kbl(
      caption = titulo,
      booktabs = TRUE,
      align = c("l", rep("c", ncol(tabla_final) - 1)),
      digits = 1,
      linesep = ""
    ) %>%
    kable_styling(
      latex_options = c("hold_position"),
      full_width = FALSE,
      position = "center"
    ) %>%
    row_spec(0, bold = TRUE) %>%
    row_spec(nrow(tabla_final), bold = TRUE) %>%
   footnote(
      general = "Elaboración propia.",
      general_title = "Nota.",
      footnote_as_chunk = TRUE,
      title_format = "italic"
    )
}

tabla_bivariada <- function(datos, var_fila, var_columna, 
                             titulo = "Tabla", tipo = "relativa_total") {
  
  tab <- table(datos %>% pull({{ var_fila }}), 
               datos %>% pull({{ var_columna }}))
  
  abs <- as.data.frame.matrix(tab)
  
  # Porcentaje según el tipo solicitado
  if (tipo == "relativa_fila") {
    rel <- round(prop.table(tab, margin = 1) * 100, 1)
  } else if (tipo == "relativa_columna") {
    rel <- round(prop.table(tab, margin = 2) * 100, 1)
  } else {
    rel <- round(prop.table(tab) * 100, 1)
  }
  rel <- as.data.frame.matrix(rel)
  
  # Combinar f (n%) en cada celda
  combinado <- abs
  for (j in seq_len(ncol(abs))) {
    combinado[[j]] <- paste0(abs[[j]], " (", rel[[j]], "%)")
  }
  
  combinado <- cbind(Categoría = rownames(abs), combinado)
  rownames(combinado) <- NULL
  
  # Totales por columna
  totales <- c("Total", colSums(abs))
  combinado <- rbind(combinado, totales)
  
  combinado %>%
    kbl(
      caption = titulo,
      booktabs = TRUE,
      align = c("l", rep("c", ncol(combinado) - 1)),
      linesep = ""
    ) %>%
    kable_styling(
      latex_options = c("hold_position"),
      full_width = FALSE,
      position = "center"
    ) %>%
    row_spec(0, bold = TRUE) %>%
    row_spec(nrow(combinado), bold = TRUE) %>%
   footnote(
      general = "Elaboración propia. Se presenta f (porcentaje).",
      general_title = "Nota.",
      footnote_as_chunk = TRUE,
      title_format = "italic"
    )
}

